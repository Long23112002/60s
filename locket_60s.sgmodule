#!name=Locket Gold 60s
#!desc=Mở khóa Locket Gold: Quay video 60s, viết caption dài đa dạng style, ghi âm micro & đăng video thư viện có âm thanh.
#!author=HaiLong
#!category=Locket
#!system=ios

[MITM]
hostname = %APPEND% api.revenuecat.com

[Script]
# Xóa cache headers để luôn trả về 200 OK thay vì 304 Not Modified
LocketDelCache = type=http-request,pattern=^https?:\/\/api\.revenuecat\.com\/v1\/(subscribers|receipts),script-path=https://raw.githubusercontent.com/Long23112002/60s/main/delete_cache.js

# Sửa response body trả về gói Locket Gold đầy đủ
LocketGold = type=http-response,pattern=^https?:\/\/api\.revenuecat\.com\/v1\/(subscribers|receipts),requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/Long23112002/60s/main/locket_gold.js
