#!name=Locket Gold 60s
#!desc=Mở khóa Locket Gold: Quay video 60s, viết caption dài đa dạng style, ghi âm micro & đăng video thư viện có âm thanh.
#!author=HaiLong
#!category=Locket
#!system=ios

[MITM]
hostname = %APPEND% api.revenuecat.com

[Header Rewrite]
^https?:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/?(.*?)*$) header-del x-revenuecat-etag
^https?:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/?(.*?)*$) header-del X-RevenueCat-ETag
^https?:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/?(.*?)*$) header-del if-none-match
^https?:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/?(.*?)*$) header-del If-None-Match

[Script]
# Xóa cache headers để luôn trả về 200 OK thay vì 304 Not Modified
LocketDelCache = type=http-request,pattern=^https?:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/?(.*?)*$),script-path=https://cdn.jsdelivr.net/gh/Long23112002/60s@main/delete_cache.js

# Sửa response body trả về gói Locket Gold đầy đủ
LocketGold = type=http-response,pattern=^https?:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/?(.*?)*$),requires-body=1,max-size=-1,script-path=https://cdn.jsdelivr.net/gh/Long23112002/60s@main/locket_gold.js
